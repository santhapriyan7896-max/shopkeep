{
  "name": "shopkeep",
  "version": "1.0.0",
  "private": true,
  "description": "Shopkeep – the AI sales assistant for shops that sell in Instagram DMs: replies, orders, UPI payment links, owner app. Made by Team Coge.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "test": "node --test tests/bot.test.mjs tests/app.test.mjs tests/unified.test.mjs",
    "transcript": "node tests/transcript.mjs",
    "film": "node record-video.mjs && node make-audio.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@electric-sql/pglite": "^0.5.15",
    "postgres": "^4.1.0"
  },
  "devDependencies": {
    "puppeteer-core": "^25.16.0"
  }
}
