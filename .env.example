# Copy this file to .env and fill in what you have. Never share or commit .env.

# ── The owner app (/app/) ─────────────────────────────────────
# Signs logins and encrypts stored Instagram / Razorpay secrets. Locally one is made for
# you in .data/. On a server, set a long random value and never change it.
# APP_SECRET=
# Supabase → Project → Connect → "Session pooler" connection string (with your DB password).
# Leave empty locally to use the built-in database in .data/.
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# The public address of this server (for Instagram's redirect + webhooks). Render sets it for you.
# PUBLIC_URL=https://shopkeep.onrender.com
# Invite code needed to create an account (stops strangers using your AI credits).
# SIGNUP_CODE=

# ── Instagram (see SETUP-INSTAGRAM.md) ────────────────────────
# IG_APP_ID=
# IG_APP_SECRET=
# IG_VERIFY_TOKEN=
# IG_API_VERSION=v24.0

# ── The chat brain – pick one ─────────────────────────────────
# Google Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: force a model, e.g. GEMINI_MODEL=gemini-2.5-flash (default: newest Flash that answers fast)
# GEMINI_MODEL=

# Or Anthropic Claude key from https://console.anthropic.com
# ANTHROPIC_API_KEY=
# SHOPKEEP_MODEL=claude-opus-5-5   (claude-haiku-5-5 is much cheaper for high volume)

# If both keys are set, choose: AI_PROVIDER=gemini or AI_PROVIDER=claude
# AI_PROVIDER=gemini

# ── Voice-over for the pitch video (make-audio.mjs) ───────────
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE=Eric
